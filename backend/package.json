{
  "name": "musicsync-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for MusicSync",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply musicsync-db --remote",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
